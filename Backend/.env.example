# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Add http://localhost:5174 if Vite falls back to that port.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ─── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ─── Java Verification ────────────────────────────────────────────────────────
# VERIFY_MODE: "local" (uses local JDK) | "docker" (uses Docker)
VERIFY_MODE=local
VERIFY_DOCKER_IMAGE=openjdk:21-slim
VERIFY_MAX_ATTEMPTS=3
# Maximum ms allowed for a single compile+run cycle
VERIFY_RUN_TIMEOUT_MS=10000
